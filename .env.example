# ==============================================================================
# PATISSERIE ROYALE - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (.env)
# ==============================================================================
# NOTE DE SÉCURITÉ :
# Ne commitez JAMAIS de clés de production, de mots de passe ou de secrets réels dans Git.
# Copiez ce fichier sous le nom .env.local pour configurer votre environnement local.
# ==============================================================================

# --- Supabase (Base de données et Stockage Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Clé de service Supabase (UNIQUEMENT côté serveur, NE JAMAIS préfixer par NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- Sécurité du Back-Office Administrateur ---
# Clé secrète pour signer les jetons de session (minimum 32 caractères aléatoires)
ADMIN_JWT_SECRET=super_secret_random_hex_key_for_signing_sessions_patisserie_royale_2026

# Identifiants de l'Administrateur (à configurer impérativement dans .env.local)
ADMIN_DEFAULT_EMAIL=votre-email-admin@example.com
ADMIN_DEFAULT_PASSWORD=VotreMotDePasseSecret2026!
# Code 2FA optionnel (si vous activez l'authentification à deux facteurs)
ADMIN_2FA_CODE=

# --- Limitation de Débit & Protection Anti-Brute-force ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# --- Environnement d'exécution ---
NODE_ENV=development
